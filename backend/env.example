# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/RoastMyDorm
DATABASE_URL=your-postgres-connection-string

# JWT Configuration
# Generate secrets using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=generate-a-64-char-random-hex-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=generate-another-64-char-random-hex-string
JWT_REFRESH_EXPIRES_IN=7d

# Internal cron-triggered endpoints (e.g. rental-outcome follow-up job) -
# not a JWT, a dedicated shared secret sent as X-Internal-Cron-Secret. Only
# needed for the manual/administrative HTTP fallback; the scheduler below
# never uses this secret.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_CRON_SECRET=generate-a-64-char-random-hex-string

# Runs the rental-outcome follow-up/reminder batch in-process on a ~15 min
# interval (see backend/services/dormFollowUpScheduler.js), instead of
# relying on an external cron job. Leave unset/false in development; never
# runs under NODE_ENV=test regardless of this value.
ENABLE_DORM_FOLLOWUP_SCHEDULER=false

# Admin-mediated housing-request flow (routes/housingRequests.js) - the
# ONLY recipient of a new request's admin-alert email and of a
# notification-delivery-failure alert. Never the landlord - the landlord
# is only ever emailed by services/dormHandoff.js, after real consent.
ADMIN_INQUIRY_EMAIL=admin@example.com

# Secret used ONLY to HMAC-digest the email/phone identity values stored in
# HousingRequestDedupClaim (a short-lived, few-minutes-old collection used
# purely to make duplicate-submission detection atomic) - never used for
# anything else, never applied to the DormInquiry collection itself (which
# stores the real requester email/phone in plain text, by design, since
# admins/students legitimately need to see them there).
# Generate with: openssl rand -hex 32  (or `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
# Required at startup - the app fails closed (refuses to serve housing-
# request traffic) rather than silently falling back to a weak/predictable
# key if this is unset. Safe to rotate at any time: rotating only affects
# claims created in roughly the last few minutes (the duplicate-submission
# window) - it never touches already-saved DormInquiry documents or their
# history, and the worst case of an unlucky rotation mid-request is one
# extra inquiry being created for a request that was in flight at that
# exact moment, never data loss or a leak.
HOUSING_REQUEST_DEDUP_SECRET=

# Security
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Google OAuth (for authentication)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Map API (for location services)
MAPBOX_ACCESS_TOKEN=your-mapbox-access-token

